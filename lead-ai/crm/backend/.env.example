# ============================================================================
# ENVIRONMENT CONFIGURATION - Medical CRM v2.0
# Copy this file to .env and fill in your values
# ============================================================================

# ============================================================================
# APPLICATION ENVIRONMENT (REQUIRED)
# ============================================================================
ENVIRONMENT=development
# Options: development, staging, production

# ============================================================================
# JWT AUTHENTICATION (REQUIRED)
# ============================================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ============================================================================
# DATABASE: SUPABASE (PostgreSQL Cloud - REQUIRED)
# ============================================================================
# Get these from: https://app.supabase.com/project/[project-id]/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-api-key

# ============================================================================
# COMMUNICATION: META WHATSAPP CLOUD API (REQUIRED for WhatsApp)
# ============================================================================
# Direct integration with Meta WhatsApp Business Cloud API
# Get these from: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

META_WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=crm_verify_token_change_this

# ============================================================================
# COMMUNICATION: SMTP EMAIL (REQUIRED for Email)
# ============================================================================
# Use standard SMTP for sending emails (works with Gmail, Outlook, etc.)

# Gmail SMTP (enable App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email sender details
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Medical CRM

# ============================================================================
# AI & ML: CLAUDE / ANTHROPIC (Optional but recommended)
# ============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Get key from: https://console.anthropic.com/settings/keys

# ============================================================================
# ERROR TRACKING: SENTRY (Optional)
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# ============================================================================
# FRONTEND: CORS & DEPLOYMENT
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# WEBSITE LEAD WEBHOOK (medfellowacademy.com integration)
# ============================================================================
# Shared secret checked against the X-Webhook-Secret header on
# POST /api/public/website-lead. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBSITE_LEAD_SECRET=change-this-to-a-long-random-string

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

